# ===== Wajib =====
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres
# Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# String acak panjang (buat dengan: openssl rand -hex 32)
SESSION_SECRET=
# Akun Owner dibuat otomatis saat pertama kali diakses
OWNER_USER=kiko
OWNER_PASS=ganti-password-panjang-ini
# URL publik situs (tanpa slash di akhir). Dipakai untuk callback OAuth.
BASE_URL=https://kikohousee.vercel.app

# ===== Opsional =====
MAX_UPLOAD_MB=50
STORAGE_BUCKET=files

# Verifikasi ASLI Discord (cek sudah join server)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Verifikasi ASLI YouTube (cek sudah subscribe channel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
